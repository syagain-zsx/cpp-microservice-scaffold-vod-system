{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build: 全部（scripts/build.sh）",
            "type": "shell",
            "command": "./scripts/build.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "run: 启动全部服务",
            "type": "shell",
            "command": "./scripts/run-dev.sh start",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "run: 停止全部服务",
            "type": "shell",
            "command": "./scripts/run-dev.sh stop",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "test: 单测 + 冒烟",
            "type": "shell",
            "command": "ctest --test-dir build && ./scripts/smoke-test.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
